{
  "name": "@storybook/addon-mcp",
  "version": "0.1.6",
  "description": "Help agents automatically write and test stories for your UI components",
  "keywords": [
    "storybook-addon",
    "mcp",
    "ai"
  ],
  "repository": {
    "url": "git+https://github.com/storybookjs/mcp.git",
    "directory": "packages/addon-mcp"
  },
  "license": "MIT",
  "author": "Storybook Core Team",
  "type": "module",
  "exports": {
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "dependencies": {
    "@tmcp/adapter-valibot": "^0.1.4",
    "@tmcp/transport-http": "^0.8.0",
    "tmcp": "^1.16.0",
    "valibot": "1.2.0",
    "@storybook/mcp": "0.1.1"
  },
  "devDependencies": {
    "storybook": "10.1.2"
  },
  "peerDependencies": {
    "storybook": "^9.1.16 || ^10.0.0 || ^10.1.0-0 || ^10.2.0-0 || ^10.3.0-0 || ^10.4.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Addon MCP",
    "supportedFrameworks": [
      "react",
      "vue3",
      "angular",
      "web-components",
      "html",
      "svelte",
      "preact",
      "react-native"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsdown",
    "inspect": "mcp-inspector --config ../../.mcp.inspect.json --server storybook-addon-mcp",
    "publint": "publint",
    "test": "cd ../.. && pnpm vitest --project=@storybook/addon-mcp",
    "typecheck": "tsc"
  }
}